# FactoryOS Environment Configuration

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=factory_os
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/factory_os

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Services
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai-service:8001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8001

# Models
MODELS_DIR=/app/models
MODEL_HOT_RELOAD=true
MODEL_RELOAD_INTERVAL_SECONDS=30

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development
